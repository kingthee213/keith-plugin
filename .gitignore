# build output
build/
dist/
build-*/
out/
*.o
*.obj
*.dSYM/
.DS_Store
# vendored SDK checkouts pulled by the build (never committed as our own)
third_party/iPlug2/
third_party/Airwindows/
# Eigen is ~8 MB of headers, fetched by bootstrap-deps instead of committed. Bungee needs it.
third_party/eigen/
# The CC0 percussion SOURCES: 5.4 MB of third-party files, fetched and hash-verified by
# tools/build_percussion_kits.py --fetch. The derived kits are committed; the raw set is not.
resources/samples/percussion-src/
tools/pluginval/
# scratch
.sam-*
*.prompt.txt
__pycache__/
*.pyc
# Blender autosave backups (keep the .blend source, not its rotated backups)
*.blend1
*.blend2

# analysis material: reference recordings used to derive synthesis targets.
# Never shipped, never committed. See docs/DECISIONS.md D2 and docs/REFERENCE-ANALYSIS.md
reference-audio/

# ephemeral worker dispatch prompts
.prompt-*.txt
third_party/iPlug2
third_party/Airwindows
