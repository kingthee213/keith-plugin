#!/usr/bin/env bash
# Fetches iPlug2 at a pinned revision into third_party/iPlug2/ (gitignored).
# CI and local builds must use the same revision — see README.md.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEST="${ROOT}/third_party/iPlug2"
# Pinned iPlug2 revision (full SHA). Do not float main.
IPLUG2_REV="d54f69050f517e43b941d88c2a170f0a840b9ee4"
IPLUG2_REPO="https://github.com/iPlug2/iPlug2.git"

if [[ -d "${DEST}/.git" ]]; then
  echo "Updating existing iPlug2 checkout at ${DEST}"
  git -C "${DEST}" fetch --depth 1 origin "${IPLUG2_REV}"
  git -C "${DEST}" checkout --detach "${IPLUG2_REV}"
  git -C "${DEST}" submodule update --init --recursive
else
  echo "Cloning iPlug2 ${IPLUG2_REV} into ${DEST}"
  # Retried, because iPlug2 is hosted on GitLab and GitLab returns
  # "unable to handle this request due to load" often enough to have failed a build on its own.
  # A transient remote outage should cost a retry, not a red run and a wasted look at the code.
  cloned=0
  for attempt in 1 2 3 4; do
    if git clone --recursive "${IPLUG2_REPO}" "${DEST}"; then
      cloned=1
      break
    fi
    echo "  clone attempt ${attempt} failed; retrying in $((attempt * 10))s"
    rm -rf "${DEST}"
    sleep $((attempt * 10))
  done
  if [ "${cloned}" -ne 1 ]; then
    echo "ERROR: could not clone iPlug2 after 4 attempts. If the message above says" >&2
    echo "       'GitLab is currently unable to handle this request due to load', that is an" >&2
    echo "       outage on their side and re-running the job is the fix." >&2
    exit 1
  fi
  git -C "${DEST}" checkout --detach "${IPLUG2_REV}"
  git -C "${DEST}" submodule update --init --recursive
fi

echo "Fetching plugin SDKs (VST3, etc.)..."
(
  cd "${DEST}/Dependencies/IPlug"
  ./download-iplug-sdks.sh
)

echo "iPlug2 ready at ${IPLUG2_REV}"

# --- Eigen -------------------------------------------------------------------------------
# Bungee (the time-stretcher behind the sampler's warp feature) includes Eigen/Core. Header
# only, but roughly 8 MB of it, which is far more than we want committed: it is larger than
# everything else tracked in third_party/ put together. So it is fetched here at a pinned tag
# rather than vendored, which is the pattern this script already exists for.
#
# MIT licensed, so no copyleft question. Pinned to the 3.4.0 tag rather than a branch: a
# deliberate version bump should be a deliberate edit to this file.
EIGEN_DEST="${ROOT}/third_party/eigen"
EIGEN_REV="3147391d946bb4b6c68edd901f2add6ac1f31f8c"  # 3.4.0
EIGEN_REPO="https://gitlab.com/libeigen/eigen.git"

if [[ -d "${EIGEN_DEST}/.git" ]]; then
  echo "Updating existing Eigen checkout at ${EIGEN_DEST}"
  git -C "${EIGEN_DEST}" fetch --depth 1 origin "${EIGEN_REV}"
  git -C "${EIGEN_DEST}" checkout --detach "${EIGEN_REV}"
else
  echo "Cloning Eigen ${EIGEN_REV} into ${EIGEN_DEST}"
  git clone --depth 1 --branch 3.4.0 "${EIGEN_REPO}" "${EIGEN_DEST}"
  git -C "${EIGEN_DEST}" checkout --detach "${EIGEN_REV}"
fi

echo "Eigen ready at ${EIGEN_REV}"
